# Zkopíruj do .env.local (lokálně) nebo nastav jako Environment Variables
# ve Vercelu. NIKDY necommituj vyplněný soubor.

# --- AI kouč (povinné) ---------------------------------------------------
# Klíč pro Google Gemini API — https://aistudio.google.com/apikey
# Bez něj nefunguje kouč, analýza fotek jídla ani onboarding.
COACH_API_KEY=
# Volitelně jiný model (výchozí gemini-2.5-flash)
# COACH_MODEL=gemini-2.5-flash

# --- Úložiště (povinné) --------------------------------------------------
# Upstash Redis přes Vercel Marketplace (Storage -> Redis). Integrace tyhle
# proměnné nastaví sama; vyplňuj ručně jen při běhu mimo Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativní názvy, když databázi zakládáš přímo v Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Telegram bot (volitelné) --------------------------------------------
# Bez těchhle proměnných appka funguje, jen nepůjde propojit Telegram.
# Token dostaneš od @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Denní check-in cron (volitelné) -------------------------------------
# Libovolný náhodný řetězec. Chrání /api/telegram-cron před cizím voláním.
CRON_SECRET=

# --- Hosting (volitelné) -------------------------------------------------
# Doména nasazení, na kterou míří tlačítko "Upravit" v Telegramu.
# Na Vercelu se bere automaticky z VERCEL_PROJECT_PRODUCTION_URL.
# APP_DOMAIN=tvoje-domena.vercel.app

# Kontakt do User-Agent hlavičky pro Open Food Facts (vyhledávání jídel
# a čtečka čárových kódů). Slušnost vůči jejich API — dej svůj e-mail
# nebo odkaz na svůj fork.
# OFF_CONTACT=ty@priklad.cz

# --- Migrace z Vercel Blob (jen historické) ------------------------------
# Potřeba pouze při přenosu starých dat z Vercel Blob do Redisu.
# BLOB_READ_WRITE_TOKEN=
