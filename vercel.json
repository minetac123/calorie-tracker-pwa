{
  "cleanUrls": true,
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/telegram-cron",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
